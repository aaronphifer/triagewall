# Triagewall configuration
# Copy this file to .env and edit for your environment.

# === Docker Host Mappings ===
# Where Triagewall stores its database, position file, and runtime state.
# This MUST be a dedicated subdirectory, NOT your project root —
# otherwise database files mix into your source tree.
HOST_DATA_DIR=./data

# Directory containing your live Suricata eve.json.
# Triagewall will mount this directory and read ${EVE_PATH} inside it.
# Common values:
#   /var/log/suricata               (Suricata running locally)
#   /var/log/suricata-opnsense      (rsync'd from OPNsense)
#   /var/log/suricata-pfsense       (rsync'd from pfSense)
HOST_EVE_DIR=/var/log/suricata

# Private exact-IP asset inventory mounted read-only into the ingest container.
# Keep real host details out of Git. The tracked example is a valid empty inventory.
# Changes are loaded only when the ingest container restarts.
HOST_ASSET_INVENTORY=./triagewall/config/assets.example.json

# === LLM Backend ===
# Ollama endpoint and model name. The model must already be pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hf.co/gabriellarson/Foundation-Sec-8B-Instruct-GGUF:Q5_K_M

# Comma-separated internal subnets for the SOC prompt context used by the LLM.
# Default matches the original hardcoded prompt.
INTERNAL_SUBNETS=10.0.0.0/24 and 192.168.1.0/24

# === Alert Source ===
# Path to Suricata's eve.json INSIDE the container.
# The directory mount makes /var/log/suricata/ point at HOST_EVE_DIR on the host.
# (Leave this as-is unless you have a custom setup.)
EVE_PATH=/var/log/suricata/eve.json

# Position tracking — daemon stores its read offset here (Leave this as-is)
POSITION_PATH=/var/lib/triagewall/position.json

# How often to poll eve.json for new content (seconds)
POLL_INTERVAL=10

# Demo mode generates synthetic alerts instead of reading eve.json
DEMO_MODE=false

# === Database ===
# SQLite database path INSIDE the container (Leave this as-is)
DB_PATH=/var/lib/triagewall/triage.db

# === Dashboard ===
DASHBOARD_PORT=8084
DASHBOARD_HOST=0.0.0.0
# Comma-separated DNS names accepted by the dashboard. Localhost and all IP
# literals are accepted automatically; add reverse-proxy/custom DNS names here.
TRUSTED_HOSTS=localhost

# Health endpoint stale threshold (seconds). If the newest processed alert
# is older than this, /api/health returns HTTP 503 with status: stale.
STALE_THRESHOLD_SECONDS=600

# === HTTP API (v1) ===
# Comma-separated API keys stored as PBKDF2 digests (never plaintext):
#   name:pbkdf2_sha256$iterations$salt_hex$digest_hex:scope|scope
# Scopes: read, feedback:write, config:write
# Guided generator (run privately; it prints the plaintext key once):
#   python scripts/generate_api_key.py
# Copy its single-quoted Compose-safe assignment here. If keys already exist,
# append the new hash-only record inside the same quotes with a comma.
# TRIAGEWALL_API_KEYS='config-admin:pbkdf2_sha256$210000$...:config:write'
# Stable secret for the same-origin dashboard write cookie (HttpOnly).
# This cookie is CSRF resistance for the built-in UI, NOT user authentication:
# it proves a write came from a page Triagewall served, not who sent it.
# If unset, an ephemeral secret is generated each process start.
# TRIAGEWALL_DASHBOARD_WRITE_SECRET=
#
# Set the Secure attribute on the dashboard write cookie. Enable this whenever
# the dashboard is reached over HTTPS (for example behind a reverse proxy) so
# the browser will not send the cookie over plaintext.
TRIAGEWALL_DASHBOARD_COOKIE_SECURE=false
#
# When true (default), GET read endpoints and /metrics work without an API key.
# Feedback writes require an API key with feedback:write or the dashboard cookie.
TRIAGEWALL_API_ALLOW_UNAUTHENTICATED_READS=true
#
# Configuration reads always require an attributable API key with config:write.
# Configuration mutations additionally require this default-off flag.
# Startup fails if the flag is true without a configured config:write key.
TRIAGEWALL_CONFIG_WRITES_ENABLED=false
#
# Ingest processes check for a new complete configuration generation between
# records at this interval. Allowed range: 1-300 seconds.
TRIAGEWALL_CONFIG_RELOAD_INTERVAL_SECONDS=5
#
# When true, replace src_ip/dest_ip (and SPC ip) in API responses with a keyed
# pseudonym. Default false so trusted LAN operators see real addresses. Demo
# mode still applies its own stricter masking, independently of this setting.
TRIAGEWALL_API_REDACT_IPS=false
#
# Required when TRIAGEWALL_API_REDACT_IPS=true. Pseudonyms are HMAC-SHA256 keyed
# with this secret; without a key an IP "hash" is reversible by exhaustive
# search over the address space, so startup fails rather than pretending
# otherwise. Must be at least 32 characters and MUST differ from
# TRIAGEWALL_DASHBOARD_WRITE_SECRET. Keep it stable: changing it changes every
# pseudonym and breaks correlation with previously exported data.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# TRIAGEWALL_API_IP_HASH_SECRET=

# === Logging ===
LOG_LEVEL=INFO

# === Optional: Wazuh alerts.json integration ===
# Reads the existing local Wazuh Docker log volume; no API credentials needed.
# See docs/wazuh-integration.md before enabling the profile.
# WAZUH_LOGS_VOLUME=wazuh_logs
# Numeric group that owns the alerts directory inside the Wazuh volume.
# WAZUH_LOGS_GID=999
# Safe stable identifier for this Wazuh deployment (1-64 characters).
# WAZUH_SOURCE_ID=wazuh-local
# Only alerts at or above this Wazuh rule level enter Triagewall.
# WAZUH_MIN_LEVEL=8
# Used only when wazuh-position.json does not exist.
# WAZUH_START_MODE=end
# WAZUH_POSITION_PATH=/var/lib/triagewall/wazuh-position.json
# WAZUH_POLL_INTERVAL=10
# Timezone for the wazuh-ingest container. It MUST match the Wazuh manager's
# timezone: Wazuh names its daily ossec-alerts-DD archives by the manager's
# local calendar, and a mismatch can stop ingest fail-closed at rotation.
# TZ=UTC

# === Optional: Zeek conn.log enrichment index ===
# The `zeek` profile builds a private local context index and exposes no port.
# Automatic Core enrichment remains default-off; set this true only when the
# profile is running and the index is populated.
# conn.log must use Zeek's JSON format (`@load policy/tuning/json-logs`).
# ZEEK_ENRICHMENT_ENABLED=false
# HOST_ZEEK_LOG_DIR=/opt/zeek/logs
# ZEEK_CONN_PATH=/var/log/zeek/current/conn.log
# Optional application logs used only for an operator-triggered deep lookup.
# ZEEK_DNS_PATH=/var/log/zeek/current/dns.log
# ZEEK_HTTP_PATH=/var/log/zeek/current/http.log
# ZEEK_SSL_PATH=/var/log/zeek/current/ssl.log
# ZEEK_X509_PATH=/var/log/zeek/current/x509.log
# ZEEK_FILES_PATH=/var/log/zeek/current/files.log
# ZEEK_NOTICE_PATH=/var/log/zeek/current/notice.log
# ZEEK_ARCHIVE_ROOT=/var/log/zeek
# ZEEK_INDEX_PATH=/var/lib/triagewall/zeek-context.db
# ZEEK_SOURCE_ID=zeek-local
# Automatic enrichment retries only `no_match` within this bounded catch-up
# window. Other outcomes remain immediate Core fallbacks.
# ZEEK_CATCHUP_TIMEOUT_SECONDS=3
# ZEEK_CATCHUP_RETRY_INTERVAL_SECONDS=0.5
# ZEEK_POLL_INTERVAL=2
# ZEEK_MAX_RECORDS_PER_POLL=1000
# ZEEK_EOF_STABLE_OBSERVATIONS=2
# ZEEK_RETENTION_DAYS=7
# ZEEK_PRUNE_INTERVAL=60
# ZEEK_PRUNE_BATCH_SIZE=1000
# ZEEK_PRUNE_MAX_ROWS=10000

# === Optional standalone TriageWall Lab UI ===
# Lab is a separate authenticated service and is never started by the default
# Core Compose command. Generate a private access key and configuration values:
#   python scripts/generate_lab_api_key.py
# Then set the operator name plus the two generated values and start only the
# explicit Lab profile with: docker compose --profile lab up -d lab
# TRIAGEWALL_LAB_OPERATOR=local-operator
# TRIAGEWALL_LAB_API_KEY_HASH='pbkdf2_sha256$210000$...'
# TRIAGEWALL_LAB_SESSION_SECRET='...'
# LAB_BIND_ADDRESS=127.0.0.1
# LAB_PORT=8085
# TRIAGEWALL_LAB_COOKIE_SECURE=false
# TRIAGEWALL_LAB_SESSION_TTL_SECONDS=28800
# TRIAGEWALL_LAB_TRUSTED_HOSTS=localhost
# Private literal IP (or loopback only when Ollama shares the worker network
# namespace). Hostnames and public addresses are rejected by the worker.
# TRIAGEWALL_LAB_OLLAMA_URL=http://192.168.1.10:11434
# TRIAGEWALL_LAB_REQUEST_TIMEOUT_SECONDS=300
# TRIAGEWALL_LAB_POLL_INTERVAL_SECONDS=2
# TRIAGEWALL_LAB_MAX_PENDING_JOBS=4
# TRIAGEWALL_LAB_MAX_RESULTS_PER_JOB=1000
# TRIAGEWALL_LAB_STORAGE_QUOTA_BYTES=10737418240
# TRIAGEWALL_LAB_RETENTION_DAYS=30
# TRIAGEWALL_LAB_RETENTION_BATCH_SIZE=10
